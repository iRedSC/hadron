diff --git a/neoforge/src/harness/java/dev/iredsc/hadron/harness/mixin/ServerPlayerNotifySoundMixin.java b/neoforge/src/harness/java/dev/iredsc/hadron/harness/mixin/ServerPlayerNotifySoundMixin.java
